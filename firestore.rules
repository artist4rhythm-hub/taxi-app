rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════
    //  공통 함수
    // ════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    // 관리자 판별 (현우 님 계정)
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'artist4rhythm@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function couponPath(code) {
      return /databases/$(database)/documents/coupons/$(code);
    }

    function redemptionPath(code, uid) {
      return /databases/$(database)/documents/coupons/$(code)/redemptions/$(uid);
    }

    // 사용자가 스스로 바꿀 수 없는 "요금제" 관련 필드
    function planFields() {
      return ['plan', 'trialUntil', 'planUntil', 'couponCode',
              'couponRedeemedAt', 'couponDays', 'paidUntil'];
    }

    // ─── 신규 가입 문서 검사 ───
    // 요금제 없이 만들거나(free), 30일 이내 무료 체험(pro)으로만 만들 수 있음
    function validNewUser() {
      let d = request.resource.data;
      let noPaidFields = !d.keys().hasAny(['planUntil', 'couponCode',
                           'couponRedeemedAt', 'couponDays', 'paidUntil']);
      let freeStart  = !d.keys().hasAny(['plan', 'trialUntil'])
                       || (d.get('plan', 'free') == 'free' && d.get('trialUntil', null) == null);
      let trialStart = d.get('plan', '') == 'pro'
                       && d.trialUntil is timestamp
                       && d.trialUntil <= request.time + duration.value(31, 'd');
      return noPaidFields && (freeStart || trialStart);
    }

    // ─── 지금 Pro 이용 중인지 (서버 시각 기준) ───
    // 관리자가 직접 Pro로 지정한 경우: 체험·쿠폰·결제 기한 없이 계속 Pro
    function hasPro(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      let paid    = u.get('paidUntil', null) is timestamp && u.paidUntil > request.time;
      let coupon  = u.get('couponCode', null) != null
                    && u.get('couponRedeemedAt', null) is timestamp
                    && (u.get('couponDays', 0) == 0
                        || u.couponRedeemedAt + duration.value(u.couponDays, 'd') > request.time);
      let trial   = u.get('couponCode', null) == null
                    && u.get('trialUntil', null) is timestamp
                    && u.trialUntil > request.time;
      let granted = u.get('couponCode', null) == null
                    && u.get('trialUntil', null) == null
                    && u.get('paidUntil', null) == null;
      return u.get('plan', 'free') != 'free' && (paid || coupon || trial || granted);
    }

    // ─── 요금제 필드를 건드리지 않는 일반 수정 ───
    function noPlanChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(planFields());
    }

    // ─── 쿠폰 사용으로 인한 요금제 변경 ───
    // 같은 일괄 쓰기 안에서 "사용 기록" 문서가 새로 생겨야만 허용
    function validCouponRedeem(userId) {
      let d = request.resource.data;
      let code = d.couponCode;
      let c = get(couponPath(code)).data;
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['plan', 'couponCode', 'couponRedeemedAt', 'couponDays',
                         'trialUntil', 'planUntil'])
        && code is string && code.size() <= 40
        && !exists(redemptionPath(code, userId))
        && existsAfter(redemptionPath(code, userId))
        && c.get('disabled', false) != true
        && d.plan == c.plan
        && d.couponDays == c.get('duration', 0)
        && d.couponRedeemedAt == request.time
        && d.trialUntil == null
        && d.planUntil == null;
    }

    // ════════════════════════════════════════
    //  사용자 데이터
    // ════════════════════════════════════════
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && validNewUser()) || isAdmin();
      allow update: if isAdmin()
                    || (isOwner(userId) && (noPlanChange() || validCouponRedeem(userId)));
      allow delete: if isAdmin();

      // 급여 조건·급여 이력: 읽기는 본인, 저장은 Pro 이용자만
      match /salaryRules/{ruleId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isAdmin() || (isOwner(userId) && hasPro(userId));
      }
      match /salaryHistory/{histId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isAdmin() || (isOwner(userId) && hasPro(userId));
      }

      // 매출 기록·메모 등 그 밖의 하위 데이터: 본인과 관리자만
      match /{sub}/{rest=**} {
        allow read, write: if (isOwner(userId) || isAdmin())
                           && !(sub in ['salaryRules', 'salaryHistory']);
      }
    }

    // ════════════════════════════════════════
    //  회사별 급여 조건 프리셋
    //  로그인한 사용자: 읽기 / 관리자: 작성·수정·삭제
    // ════════════════════════════════════════
    match /companyPresets/{presetId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════
    //  쿠폰
    //  - 목록 조회는 관리자만 (코드 노출 방지)
    //  - 사용자는 코드를 정확히 알 때만 1건 조회
    //  - 사용 횟수는 1씩만 증가, 최대 사용 횟수 초과 불가
    // ════════════════════════════════════════
    match /coupons/{code} {
      allow get:  if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usedCount', 'lastUsedAt'])
            && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
            && (resource.data.get('maxUses', 0) == 0
                || request.resource.data.usedCount <= resource.data.get('maxUses', 0))
            && request.resource.data.lastUsedAt == request.time
            && !exists(redemptionPath(code, request.auth.uid))
            && existsAfter(redemptionPath(code, request.auth.uid)));

      // 쿠폰 사용 기록 (1인 1회)
      match /redemptions/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['at', 'email'])
          && request.resource.data.at == request.time
          && getAfter(couponPath(code)).data.get('usedCount', 0)
             == get(couponPath(code)).data.get('usedCount', 0) + 1;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ════════════════════════════════════════
    //  기존 공용 데이터 (이전용) — 관리자만
    // ════════════════════════════════════════
    match /taxiData/{document=**} {
      allow read, write: if isAdmin();
    }

    // ════════════════════════════════════════
    //  접속 로그 — 본인 이름으로만 기록, 관리자만 조회
    // ════════════════════════════════════════
    match /accessLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'time', 'hour',
                                                 'deviceType', 'browser', 'ua'])
        && request.resource.data.get('ua', '').size() <= 200;
      allow read, delete: if isAdmin();
    }

    // ════════════════════════════════════════
    //  문의 채팅 — 본인과 관리자만
    // ════════════════════════════════════════
    match /messages/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /messages/{userId}/chats/{chatId} {
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      // 본인은 자기 이름으로만, 1,000자 이내로 작성 (관리자 사칭 방지)
      allow create, update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.get('sender', '') == request.auth.uid
            && request.resource.data.get('text', '').size() <= 1000);
    }
  }
}
